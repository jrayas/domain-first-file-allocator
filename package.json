{
  "name": "domain-first-file-allocator",
  "version": "1.0.0",
  "description": "Files notes into folders according to a domain property in their frontmatter.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
